#include <bits/stdc++.h>
using namespace std;

long long a[1000000000005];

int main(){
    freopen("crystal.in","r",stdin);
    freopen("crystal.out","w",stdout);
    long long n,m;
    cin >> n >> m;
    for(int i=0;i<n;i++){
        cin >> a[i];
    }
    long long mx=0;
    long long x=0;
    long long y=0;
    for(int i=0;i<n;i++){
        if(a[i]>mx){
            for(int j=0;j<n;j++){
                if(mx==a[i]&&y<=m){
                    x+=2*mx+1;
                    y++;
                }

            }
        }
    }
    cout << x;
    return 0;
}
